# orbien (CLI client) — multi-stage image
ARG RUST_VERSION=1.88

FROM rust:${RUST_VERSION}-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core ./core
COPY client ./client
COPY server ./server
COPY desktop ./desktop
RUN cargo build --release -p orbien-client \
    && strip target/release/orbien

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/orbien /usr/local/bin/orbien
COPY docker/conf/orbien.toml /etc/orbien/orbien.toml
ENTRYPOINT ["orbien"]
CMD ["-c", "/etc/orbien/orbien.toml"]
